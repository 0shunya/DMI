# Copy to .env, then replace BOTH values using independent random hex strings.
# Example: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-value
SECRET_KEY=replace-with-another-random-64-character-hex-value

# Bind locally by default; add your own HTTPS reverse proxy for public access.
DMI_BIND=127.0.0.1
DMI_PORT=8080
SCRAPE_INTERVAL_SECONDS=21600

# Optional: local Ollama only; leave blank to keep the draft feature disabled.
OLLAMA_URL=
OLLAMA_MODEL=gemma3:1b

# Auth callback and email verification.
# Local development can keep EMAIL_PROVIDER=log; the OTP appears in API logs.
FRONTEND_URL=http://localhost:8080
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=DMI <onboarding@resend.dev>

# Optional OAuth providers. Register callbacks at:
# http://localhost:8080/api/auth/google/callback
# http://localhost:8080/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
